@model SelfOrderSystem.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "メニュー";
}

<div class="@(Model.CartItemCount > 0 ? "so-has-mobile-bar" : "")">
    <div class="so-page-header">
        <h1 class="h3 mb-1">メニュー</h1>
        <p>お好きな商品をお選びください</p>
    </div>

    <!-- カテゴリタブ -->
    <div class="so-category-tabs">
        <a class="so-category-pill @(Model.SelectedCategoryId == null ? "active" : "")"
           asp-action="Index">
            すべて
        </a>
        @foreach (var category in Model.Categories) {
            <a class="so-category-pill @(Model.SelectedCategoryId == category.Id ? "active" : "")"
               asp-action="Index"
               asp-route-categoryId="@category.Id">
                @category.Name
            </a>
        }
    </div>

    @* CartController から渡されたエラーがあれば表示 *@
    @if (TempData["Error"] is string errorMessage) {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="row g-4">
        <!-- 左側：商品一覧 -->
        <div class="col-12 col-lg-9">
            <div class="row g-3 g-md-4">
                @foreach (var product in Model.Products) {
                    <div class="col-12 col-sm-6 col-xl-4">
                        <div class="card h-100 so-product-card @(product.IsSoldOut ? "is-sold-out" : "")">
                            <div class="so-photo-wrap">
                                @if (!string.IsNullOrWhiteSpace(product.ImagePath)) {
                                    <img src="@Url.Content(product.ImagePath)"
                                         class="so-product-photo"
                                         alt="@product.Name"
                                         loading="lazy" />
                                } else {
                                    <div class="so-product-photo so-product-photo--empty">
                                        <i class="bi bi-image fs-3"></i>
                                        <span>写真準備中</span>
                                    </div>
                                }

                                @if (product.IsSoldOut) {
                                    <span class="so-soldout-badge">売り切れ</span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-3 p-md-4">
                                <h2 class="so-product-title">@product.Name</h2>
                                <p class="so-product-desc flex-grow-1">@product.Description</p>

                                <div class="so-product-price">
                                    @product.Price.ToString("N0") <span>円</span>
                                </div>

                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    @if (product.IsSoldOut) {
                                        <button class="btn btn-secondary w-100" disabled>
                                            売り切れ
                                        </button>
                                    } else {
                                        <button class="btn btn-primary w-100" type="submit">
                                            <i class="bi bi-plus-lg me-1"></i>カートに追加
                                        </button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 右側：カート概要（PC表示） -->
        <div class="col-12 col-lg-3 d-none d-lg-block">
            <aside class="card so-cart-sidebar">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-cart3 text-accent"></i>現在のカート
                    </h2>

                    <div class="so-cart-summary-box">
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span>注文点数</span>
                            <strong class="text-dark">@Model.CartItemCount 点</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="text-muted small">合計金額</span>
                            <strong class="fs-4" style="color: var(--so-ink);">
                                @Model.CartTotal.ToString("N0")<span class="fs-6 ms-1">円</span>
                            </strong>
                        </div>
                    </div>

                    <a asp-controller="Cart" asp-action="Index"
                       class="btn btn-primary w-100 d-flex justify-content-center align-items-center gap-2">
                        <span>カートを確認</span>
                        <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>
            </aside>
        </div>
    </div>
</div>

@* スマホ・タブレット画面用：画面下部に固定表示されるカートバー *@
@if (Model.CartItemCount > 0) {
    <div class="so-mobile-cart-bar d-lg-none">
        <div>
            <div class="small opacity-75">現在のカート（@Model.CartItemCount 点）</div>
            <div class="fw-bold fs-5">@Model.CartTotal.ToString("N0") 円</div>
        </div>
        <a class="btn btn-primary px-3" asp-controller="Cart" asp-action="Index">
            カートを見る <i class="bi bi-chevron-right ms-1"></i>
        </a>
    </div>
}