@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SelfOrderSystem</title>

    <!-- Google Fonts (Noto Sans JP) & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SelfOrderSystem.styles.css" asp-append-version="true" />
</head>
<body class="so-body">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-light so-navbar">
            <div class="container">
                <a class="navbar-brand so-brand" asp-area="" asp-controller="Menu" asp-action="Index">
                    <i class="bi bi-shop me-2 text-accent"></i>SelfOrderSystem
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <!-- お客様向けメインメニュー -->
                    <ul class="navbar-nav me-auto gap-sm-1">
                        <li class="nav-item">
                            <a class="nav-link so-nav-link @(currentController == "Home" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link so-nav-link @(currentController == "Menu" ? "active" : "")"
                               asp-area="" asp-controller="Menu" asp-action="Index">
                                <i class="bi bi-book me-1"></i>メニュー
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link so-nav-link @(currentController == "Cart" ? "active" : "")"
                               asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 me-1"></i>カート
                            </a>
                        </li>
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("LastOrderPublicId"))) {
                            <li class="nav-item">
                                <a class="nav-link so-nav-link so-nav-status @(currentController == "Orders" ? "active" : "")"
                                   asp-controller="Orders" asp-action="MyOrder">
                                    <i class="bi bi-receipt me-1"></i>ご注文状況
                                </a>
                            </li>
                        }


                        @* ログイン済みの場合のみログアウトを表示 *@

                        @if (User.Identity?.IsAuthenticated == true) {
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary">
                                    ログアウト
                                </button>
                            </form>
                        }



                    </ul>

                    <!-- 店舗スタッフ・その他リンク（控えめに右寄せ） -->
                    <ul class="navbar-nav align-items-sm-center gap-2 mt-2 mt-sm-0">
                        <li class="nav-item">
                            <a class="nav-link so-nav-sub @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm so-staff-link @(currentController == "Staff" ? "active" : "")"
                               asp-area="" asp-controller="Staff" asp-action="Index">
                                <i class="bi bi-clipboard-check me-1"></i>Staff管理
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container so-main-container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="so-footer mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - SelfOrderSystem</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>